                        "bg_color": "0x1C2530",
                        "bg_opa": 255,
                        "text_color": "0xE8EEF5",
                        "border_width": 1,
                        "border_color": "0x2C3A4A",
                        "radius": 8
                    },
                    "events": ["clicked", "ready"]
                }
